# Credenciales del proyecto Supabase.
# Copia este archivo a .env.local y rellena los valores reales.
# La anon key es publica por diseno: la seguridad la dan las politicas RLS.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Sign in with Apple: apagado hasta tener cuenta de Apple Developer.
VITE_APPLE_SIGN_IN=false

# Clave publica VAPID para las notificaciones push. Es publica por diseno.
VITE_VAPID_PUBLIC_KEY=

# Codigo de cliente de Cloudflare Stream, para reproducir los videos de las
# historias. Es la parte del medio de customer-XXXX.cloudflarestream.com y es
# publico por diseno. Ojo: al ser VITE_ se hornea al construir, asi que
# cambiarlo en Vercel exige volver a desplegar SIN cache de construccion.
VITE_CF_STREAM_CODE=
